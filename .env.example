# =============================================================================
# .env.example — skopiuj do .env (`make env` zrobi to za ciebie).
#
# .env jest w .gitignore i ma tam zostać.
#
# Czego tu NIE MA i nie może być:
#   - wersji przeglądarki, Codexa i obrazów — te żyją w versions.lock.toml
#     i tylko tam. Dockerfile'e czytają je z pliku, nie ze środowiska.
#   - poświadczeń do prawdziwych kont social ani do ChatGPT. F0 nie dotyka
#     prawdziwych kont; logowanie Codexa robi `make codex-gonogo` (D20)
#     i zapisuje stan w wolumenie codex-home, nie tutaj.
# =============================================================================

# --- Baza -------------------------------------------------------------------
POSTGRES_USER=wenext
POSTGRES_DB=wenext
# HASŁO DEWELOPERSKIE. Baza nie jest publikowana na host (żyje w sieci internal),
# więc lokalnie to nie jest ekspozycja — ale zmień je, zanim ten stack dotknie
# czegokolwiek, na czym ci zależy.
POSTGRES_PASSWORD=wenext-dev-local-only

# Rola read-only dla generatora raportu Go/No-Go. Zakłada ją migracja D07;
# gonogo nie ma i nie może mieć poświadczeń zapisu.
POSTGRES_RO_USER=wenext_ro
POSTGRES_RO_PASSWORD=wenext-ro-dev-local-only

# --- Gateway ----------------------------------------------------------------
# Pierwszy z DWÓCH portów publikowanych na host, zawsze na 127.0.0.1.
# Pełna lista jest w versions.lock.toml -> [[network.published_ports]] i pilnują jej
# `make check-versions` oraz tests/test_published_ports.py (D-014).
WENEXT_GATEWAY_HOST_PORT=8760
# Czas życia jednorazowego StreamTicketu (sekundy).
WENEXT_STREAM_TICKET_TTL_SECONDS=120

# --- Kapsuła ----------------------------------------------------------------
WENEXT_CAPSULE_ID=capsule-01
# HEADLESS albo INTERACTIVE. Domyślnie HEADLESS — headful jest ścieżką
# WYJĄTKOWĄ, uruchamianą wyłącznie dla LOGIN, MFA, CHALLENGE i HUMAN_TAKEOVER.
# Nie zostawiaj tu INTERACTIVE „na chwilę".
WENEXT_BROWSER_MODE=HEADLESS

# --- Dashboard (E1.F1) ------------------------------------------------------
# Drugi i OSTATNI port publikowany na host (D-014), też na pętli zwrotnej.
# Control plane NIE jest publikowany: dashboard rozmawia z nim po stronie serwera
# Next.js, żeby ciasteczko sesji nigdy nie trafiło do kodu przeglądarkowego (D-016).
WENEXT_DASHBOARD_HOST_PORT=3000

# --- Fixture site -----------------------------------------------------------
# Seed determinizmu. Zmiana unieważnia porównywalność evali między przebiegami.
WENEXT_FIXTURE_SEED=20260830

# --- Codex ------------------------------------------------------------------
# Wartości domyślne. ID modelu NIE jest hardkodowane w kodzie — runtime waliduje
# je przez model/list i czyta supportedReasoningEfforts.
WENEXT_CODEX_MODEL=gpt-5.6-terra
WENEXT_CODEX_EFFORT=medium

# --- Ogólne -----------------------------------------------------------------
WENEXT_ENV=local
TZ=Europe/Warsaw

# Dodatkowe argumenty pytest przekazywane do kontenera tests, np. -k lease
PYTEST_ADDOPTS=

# --- Obserwacja community (Outcome A, docs/OUTCOMES.md) -------------------
# Katalog z zalogowanym Codexem (auth.json) — ten sam wolumen `codex-home`, który
# zapełnia `make codex-gonogo`. Bez niego obserwacja działa, a obraz community
# i osądy czekają w WAITING_CAPABILITY (widoczne na /jobs).
WENEXT_CODEX_HOME=/var/wenext/codex-home

# Reddit przez oficjalne Data API (aplikacja typu `script`, tylko odczyt, D-023).
# Rejestracja: https://www.reddit.com/prefs/apps — pięć minut. Bez tych czterech
# zmiennych adapter Reddita mówi CredentialsMissing i poll parkuje w WAITING_CAPABILITY.
# Hacker News nie wymaga niczego.
WENEXT_REDDIT_CLIENT_ID=
WENEXT_REDDIT_CLIENT_SECRET=
WENEXT_REDDIT_USERNAME=
WENEXT_REDDIT_PASSWORD=
WENEXT_REDDIT_USER_AGENT=wenext-community-observer/0.1 (read-only observation)

# --- Reddit przez zalogowaną przeglądarkę kapsuły (plan B, D-025) ------------
# Reddit odmówił rejestracji aplikacji Data API, więc Reddit jest czytany przez Chrome
# kapsuły: człowiek loguje w nim konto, adapter czyta listingi `.json` przez czytnik
# kapsuły (GET /read za tokenem, tylko allowlista URL-i Reddita). Uruchomienie:
# `make up-observe-reddit`. Dopóki nikt nie zaloguje Reddita w kapsule, joby REDDIT
# stoją w WAITING_CAPABILITY — chyba że REQUIRE_LOGIN=false (odczyt anonimowy).
#
# Token współdzielony przez `api` i kapsułę; NIE trafia do kontenera `codex`.
# Wygeneruj: openssl rand -hex 32. Pusty = kapsuła nie startuje (czytnik fail-closed).
WENEXT_BROWSER_READER_TOKEN=
# OPT-IN. Adres czytnika widziany z `api`; puste (domyślne) = adapter REDDIT przez API OAuth
# (D-023), nawet gdy kapsuła chodzi. Wpisz http://capsule:8765, żeby czytać przez kapsułę.
WENEXT_BROWSER_READER_URL=
# `true`: odczyt wyłącznie jako zalogowane konto założyciela (STAN-PROJEKTU pkt 4).
WENEXT_REDDIT_REQUIRE_LOGIN=true
# Minimalny odstęp między odczytami Reddita przez kapsułę (sekundy). Zachowawczo.
WENEXT_READER_MIN_INTERVAL_SECONDS=2

# --- Logowanie człowieka w Chrome kapsuły (poziom 2 planu B, D-026) ----------
# Karta „przeglądarka agenta" w dashboardzie: control plane przełącza kapsułę w tryb z ekranem,
# gateway wystawia jednorazowy ticket, założyciel otwiera /login-capsule w nowej karcie i loguje
# się jak człowiek; „gotowe" wraca do trybu headful bez steru. Tickety wystawia WYŁĄCZNIE control
# plane — token współdzielony przez api i gateway (openssl rand -hex 32); puste = gateway odmawia.
WENEXT_GATEWAY_ISSUER_TOKEN=
# Adres gatewaya z sieci compose (api → gateway) i origin, który otwiera przeglądarka założyciela.
WENEXT_GATEWAY_URL=http://gateway:8760
WENEXT_STREAM_PUBLIC_ORIGIN=http://127.0.0.1:8760

# Aktuator komentarzy w kapsule (R4 minimalny, D-028): OSOBNY sekret, inny niż token czytnika;
# bez niego POST /act/comment odpowiada 404 i nic nie publikuje. Wygeneruj: openssl rand -hex 32
WENEXT_BROWSER_WRITER_TOKEN=
