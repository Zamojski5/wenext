# `engines` in package.json is a HARD requirement, not a hint.
#
# The host of this project runs Node v24.12.0 while versions.lock.toml [stack.js] pins
# 24.20.0. Without engine-strict, `npm ci` on the host installs happily, builds a
# node_modules with darwin-specific @next/swc binaries and produces artifacts from a
# runtime nobody deploys — and it does all of that with exit code 0. Exit code 0 is not
# evidence that something was done (docs/KONWENCJE.md L110). With engine-strict the wrong
# interpreter is a LOUD refusal, which is the whole point: the JS toolchain runs from the
# pinned image (apps/dashboard/tools/node.sh), never from the developer's PATH.
engine-strict=true

# Every version this package adds is written out in full. A caret range means the lock file
# and package.json disagree about what is pinned, and versions.lock.toml is not the place
# for transitive JS dependencies — package-lock.json is.
save-exact=true

fund=false
audit=false
